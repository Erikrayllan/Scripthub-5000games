--==================================================
-- MOSTRAR BALÃO
--==================================================

local function mostrarBalao(texto)
	local character = player.Character
	if not character then
		return
	end

	local head = character:FindFirstChild("Head")

	if not head then
		return
	end

	-- O Roblox cria o balão visual acima da cabeça.
	TextChatService:DisplayBubble(head, texto)
end

--==================================================
-- PEGAR NOME
--==================================================

local nome = player.DisplayName

--==================================================
-- EXECUÇÃO
--==================================================

for segundo = 1, DURACAO do

	-- Mensagem do próprio personagem
	mostrarBalao(mensagens[segundo])

	-- Algumas mensagens geram uma reação.
	-- A reação aparece depois de um pequeno intervalo.
	if segundo >= 3 and segundo % 2 == 0 then

		task.wait(0.35)

		local frase =
			reacoes[
				math.random(1, #reacoes)
			]

		frase = string.format(frase, nome)

		mostrarBalao(frase)
	end

	task.wait(INTERVALO)
end

